  "elevation": {
    "1": "0 1px 2px rgba(6,41,83,0.06), 0 1px 3px rgba(6,41,83,0.10)",
    "2": "0 4px 8px -2px rgba(6,41,83,0.10), 0 2px 4px -2px rgba(6,41,83,0.06)",
