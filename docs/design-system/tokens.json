    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "style": {
      "display": { "family": "display", "size": 36, "lineHeight": 44, "weight": 800, "tracking": "-0.01em" },
