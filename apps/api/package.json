{
  "name": "@btw/server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "build": "swc src -d dist --strip-leading-paths && tsc -p tsconfig.json --noEmit",
    "start": "node -r @swc-node/register src/main.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node -r @swc-node/register src/db/seed.ts",
    "test": "tsx test/api.e2e.ts",
    "test:integrations": "node -r @swc-node/register test/integrations.e2e.ts",
    "test:qa": "tsx test/qa.e2e.ts"
  },
  "dependencies": {
    "@btw/api": "workspace:*",
    "@fastify/static": "^8.3.0",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.7",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.11.3",
    "nodemailer": "^10.0.15",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.6.3"
  }
}
