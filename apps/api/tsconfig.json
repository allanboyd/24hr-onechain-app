{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "dist",
    "rootDir": "../..",
    "baseUrl": ".",
    "types": [
      "node"
    ],
    "paths": {
      "@btw/api/*": [
        "../../packages/api/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}
