// Delivery acknowledgement (AK-01..03). Data: /data.json (pre-formatted). Images: /signature.*, /photo-N.*
#let d = json("/data.json")
#let navy = rgb("#062953")
#let orange = rgb("#FE7514")
#let sunken = rgb("#EEF1F6")
#set page(paper: "a4", margin: 2cm, footer: context text(7.5pt, fill: rgb("#66768C"))[#d.shipmentRef · leg #d.legSeq of #d.legCount · generated by BTW Supply Chain #h(1fr) page #counter(page).display()])
#set text(font: ("Inter", "DejaVu Sans", "Libertinus Serif"), size: 10pt, fill: rgb("#0B1B33"))
#grid(columns: (1fr, auto), align: (left + horizon, right + horizon),
  if d.logo != none { image(d.logo, height: 1.6cm) } else { text(16pt, weight: "bold", fill: navy, "BTW") },
  text(14pt, weight: "bold", fill: navy)[Delivery acknowledgement])
#v(0.2cm)
#line(length: 100%, stroke: 2pt + orange)
#v(0.4cm)
#grid(columns: (auto, 1fr, auto, 1fr), column-gutter: 8pt, row-gutter: 6pt,
  text(fill: rgb("#4A5A70"))[Shipment], [*#d.shipmentRef* (leg #d.legSeq of #d.legCount)],
  text(fill: rgb("#4A5A70"))[Truck], [*#d.truckReg* #if d.driverName != none [· #d.driverName]],
  text(fill: rgb("#4A5A70"))[From], [#d.from],
  text(fill: rgb("#4A5A70"))[To], [#d.to],
  text(fill: rgb("#4A5A70"))[Received at], [#d.warehouse · #d.receivingCompany],
  text(fill: rgb("#4A5A70"))[Date / time], [#d.receivedAt],
)
#v(0.3cm)
#box(fill: if d.finalDestination { rgb("#E6F4EC") } else { rgb("#E8EFFC") }, inset: 6pt, radius: 3pt,
  text(9pt, weight: "bold", fill: if d.finalDestination { rgb("#15703A") } else { rgb("#1D4FB8") },
    if d.finalDestination [Final destination — good cases post to stock] else [Transfer point — goods continue on the next leg]))
#v(0.4cm)
#let hdr(t) = text(7.5pt, weight: "bold", fill: rgb("#4A5A70"), upper(t))
#table(columns: (1fr, auto, auto, auto, auto, auto), align: (left, right, right, right, right, left),
  stroke: (x, y) => (bottom: 0.5pt + rgb("#CBD3DF")), inset: (x: 6pt, y: 5pt), fill: (x, y) => if y == 0 { sunken },
  table.header(hdr("Brand · package"), hdr("Expected"), hdr("Received"), hdr("Damaged"), hdr("Short/over"), hdr("Remarks")),
  ..d.rows.map(r => (r.label, r.expected, r.received, r.damaged, if r.diffBad { text(fill: rgb("#B4231B"), weight: "bold", r.diff) } else { r.diff }, r.remarks)).flatten(),
  table.cell(fill: rgb("#EEF3FA"))[*Total*], table.cell(fill: rgb("#EEF3FA"))[*#d.totals.expected*], table.cell(fill: rgb("#EEF3FA"))[*#d.totals.received*], table.cell(fill: rgb("#EEF3FA"))[*#d.totals.damaged*], table.cell(fill: rgb("#EEF3FA"))[*#d.totals.diff*], table.cell(fill: rgb("#EEF3FA"))[],
)
#if d.discrepancy [#v(0.2cm) #text(fill: rgb("#B4231B"), weight: "bold")[Discrepancy recorded — report sent to directors and operations (AK-04).]]
#v(0.6cm)
#grid(columns: (1fr, 1fr), gutter: 1cm,
  [#text(8pt, fill: rgb("#66768C"), upper("Received by")) \ #if d.signature != none { image(d.signature, height: 1.4cm) } \ *#d.receiverName*],
  [])
#if d.photos.len() > 0 [
  #v(0.5cm)
  #text(8pt, fill: rgb("#66768C"), upper("Photos"))
  #v(0.2cm)
  #grid(columns: (1fr, 1fr, 1fr), gutter: 6pt, ..d.photos.map(p => image(p, width: 100%)))
]
