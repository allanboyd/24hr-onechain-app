# Copy to .env (git-ignored). Every integration falls back to a local stand-in when its key is empty.
PORT=3101
DATABASE_URL=postgres://btw:btw@localhost:55433/btw
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,capacitor://localhost,http://localhost
PUBLIC_URL=http://localhost:3101   # base for signed file links and webhook URLs
FILES_DRIVER=local                 # local | s3
FILES_DIR=./var/files              # local document store (photos, signatures, PDFs)
MAX_UPLOAD_MB=10
S3_ENDPOINT=                       # s3 driver: AWS S3, Cloudflare R2 or MinIO endpoint
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email: SMTP (Mailpit locally)
SMTP_URL=smtp://localhost:11025
MAIL_FROM="BTW Supply Chain <no-reply@btw.local>"

# SMS / USSD: Africa's Talking. Empty key → dev inbox (GET /v1/dev/sms; simulate a driver: POST /v1/dev/sms/inbound)
# Sandbox: AT_USERNAME=sandbox + sandbox API key. Live: your app username + live key.
# In the AT dashboard set SMS callback → <PUBLIC_URL>/v1/webhooks/sms and USSD callback → <PUBLIC_URL>/v1/webhooks/ussd
AT_USERNAME=sandbox
AT_API_KEY=
AT_SHORTCODE=
AT_SENDER_ID=
WEBHOOK_SECRET=                    # when set, callbacks must include ?key=<secret>

# Push: Firebase Cloud Messaging service-account JSON (file path or the JSON itself). Empty → GET /v1/dev/push
FCM_SERVICE_ACCOUNT=

# Routing for ETA seeds: OSRM-compatible base URL (public demo by default; self-host later)
OSRM_URL=https://router.project-osrm.org
TRUCK_TIME_FACTOR=1.4              # OSRM car time × factor ≈ loaded truck

# PDF (Typst, in-process): font folders searched for Inter / DejaVu Sans
PDF_FONT_DIRS=/usr/share/fonts/truetype
